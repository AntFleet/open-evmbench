diff --git a/smart-contracts/src/modules/Storage.sol b/smart-contracts/src/modules/Storage.sol
index 1e46bcb..8fbb6f8 100644
--- a/smart-contracts/src/modules/Storage.sol
+++ b/smart-contracts/src/modules/Storage.sol
@@ -190,6 +190,11 @@ contract Storage is Proxiable, Module, StorageBase {
         bytes32 orderHash,
         RentalAssetUpdate[] memory rentalAssetUpdates
     ) external onlyByProxy permissioned {
+        // The order must not already be active.
+        if (orders[orderHash]) {
+            revert Errors.StorageModule_OrderAlreadyExists(orderHash);
+        }
+
         // Add the order to storage.
         orders[orderHash] = true;
 
