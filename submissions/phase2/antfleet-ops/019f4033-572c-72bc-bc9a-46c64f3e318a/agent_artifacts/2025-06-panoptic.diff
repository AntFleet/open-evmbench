+                _withdrawalEpochState.sharesFulfilled) / _withdrawalEpochState.sharesWithdrawn;
+            // assets to withdraw = prorated shares to withdraw * assets fulfilled / total shares fulfilled
+            assetsToWithdraw = Math.mulDiv(
