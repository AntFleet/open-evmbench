+                _withdrawalEpochState.sharesWithdrawn;
+        }
         uint256 performanceFee = (uint256(
             Math.max(0, int256(assetsToWithdraw) - int256(withdrawnBasis))
         ) * performanceFeeBps) / 10_000;
