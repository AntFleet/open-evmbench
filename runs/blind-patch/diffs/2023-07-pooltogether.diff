+  /**
+   * @notice Maximum shares that can be minted to `_receiver` without exceeding TWAB limits.
+   * @param _receiver The receiver of newly minted shares
+   * @return uint256 Maximum mintable shares
+   */
+  function _maxMint(address _receiver) internal view returns (uint256) {
+    uint256 _totalShareSupply = _totalShares();
+    if (_totalShareSupply >= type(uint96).max) return 0;
+
+    uint256 _remainingSupply = type(uint96).max - _totalShareSupply;
+    uint256 _remainingReceiverBalance = type(uint96).max - balanceOf(_receiver);
+
+    return Math.min(_remainingSupply, _remainingReceiverBalance);
+  }
